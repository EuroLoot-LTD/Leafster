# Local only: never commit real secrets. Default server binds to loopback.
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
LEAFSTER_DATA_DIR=./data
# Create a Web application OAuth client in EuroLoot's Google Cloud project.
# Register exact callback: http://127.0.0.1:5173/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Invitation-only adult testers, comma separated. Empty means nobody can sign in.
LEAFSTER_ALLOWED_EMAILS=
# Optional separately maintained executables; convenience dev packages otherwise.
FFMPEG_PATH=
FFPROBE_PATH=
# Do not enable test authentication outside isolated automated test runs.
LEAFSTER_TEST_AUTH=false
